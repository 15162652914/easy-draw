.sheet-content {
  padding: 24rpx 32rpx 32rpx;
  background-color: #fff;
}

.avatar-wrap {
  display: flex;
  justify-content: center;
  margin-bottom: 32rpx;
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background-color: #f7f8fa;
  border: 4rpx solid #667eea;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.25);
}

.form-item {
  margin-bottom: 32rpx;
}

.label {
  display: block;
  margin-bottom: 16rpx;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.input {
  height: 88rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  border: 1rpx solid #f0f0f0;
  background-color: #f7f8fa;
  font-size: 28rpx;
  box-sizing: border-box;
}

.input:focus {
  background-color: #fff;
  border-color: #667eea;
}

.btn-primary {
  margin-top: 8rpx;
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 40rpx;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(118, 75, 162, 0.25);
}

.btn-primary:active {
  opacity: 0.9;
}

.tip {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #999;
  line-height: 1.6;
}
