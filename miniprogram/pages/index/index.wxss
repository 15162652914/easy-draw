.container {
  min-height: 100vh;
  background-color: #f7f8fa;
  padding: 32rpx;
  box-sizing: border-box;
}

.header {
  padding: 40rpx 20rpx;
  text-align: center;
  margin-bottom: 40rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 24rpx;
  color: #fff;
  box-shadow: 0 8rpx 20rpx rgba(118, 75, 162, 0.2);
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 28rpx;
  opacity: 0.9;
}

.template-section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
  padding-left: 10rpx;
}

.template-list {
  display: grid;
  grid-template-columns: 1fr;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.template-card {
  display: flex;
  align-items: center;
  background-color: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
  transition: all 0.2s ease-in-out;
}

.template-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.template-icon {
  font-size: 56rpx;
  margin-right: 32rpx;
  background-color: #f7f8fa;
  width: 90rpx;
  height: 90rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.template-content {
  display: flex;
  flex-direction: column;
}

.template-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.template-desc {
  font-size: 24rpx;
  color: #888;
  line-height: 1.5;
}

/* 空白模板样式稍作强调 */
.blank-template {
  border: 2rpx dashed #667eea;
}

