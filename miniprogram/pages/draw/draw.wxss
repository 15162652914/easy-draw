.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 20rpx;
}

.loading,
.error {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.error text {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 30rpx;
}

.retry-btn {
  width: 200rpx;
  height: 60rpx;
  background-color: #07c160;
  color: #fff;
  font-size: 28rpx;
  border-radius: 30rpx;
}

.draw-info {
  margin-bottom: 60rpx;
}

.draw-card {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  margin-bottom: 40rpx;
}
.draw-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 20rpx;
  text-align: center;
}

.draw-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.status-badge {
  padding: 6rpx 18rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #fff;
}
.status-ongoing { background-color: #07c160; }
.status-closed { background-color: #999; }

.creator-block {
  display: flex;
  align-items: center;
}
.creator-avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  overflow: hidden;
  margin-right: 20rpx;
  border: 2rpx solid #eee;
}
.creator-meta {
  display: flex;
  flex-direction: column;
}
.creator-name {
  font-size: 26rpx;
  color: #666;
}

.draw-creator,
.draw-time {
  font-size: 24rpx;
  color: #666;
  display: block;
  margin-bottom: 12rpx;
}

.options-preview {
  margin-top: 30rpx;
  margin-bottom: 30rpx;
}

.options-label {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 16rpx;
}

.options-list {
  margin-left: 0;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.option-chip {
  padding: 12rpx 20rpx;
  background-color: #fafafa;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #444;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.03);
}

.participants {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #eee;
}

.participants-label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
}

.avatars-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}
.avatar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 120rpx;
}
.avatar-item image {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  border: 2rpx solid #f0f0f0;
}
.avatar-name {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #666;
  text-align: center;
  width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.my-badge {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #07c160;
}

.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-around;
  gap: 20rpx;
  background-color: #fff;
  padding: 20rpx;
  padding-bottom: calc(20rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.05);
}

.action-row {
  display: flex;
  gap: 18rpx;
  width: 100%;
}

.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 8rpx;
  font-size: 28rpx;
  border-radius: 32rpx;
  background-color: #f7f7f7;
  color: #333;
  height: 80rpx;
  padding: 0 24rpx;
}

.action-btn.primary {
  background-color: #07c160;
  color: #fff;
  font-weight: bold;
}
.action-btn.danger {
  background: linear-gradient(135deg, #ff7676 0%, #ff4d4f 100%);
  color: #fff;
  font-weight: bold;
  box-shadow: 0 4rpx 12rpx rgba(255, 77, 79, 0.25);
}
.action-btn.disabled {
  opacity: 0.5;
  pointer-events: none;
}
button::after { border: none; }
