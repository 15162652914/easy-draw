<view class="container">
  <!-- User Info -->
  <view class="user-info-card" bindtap="login">
    <image class="avatar" src="{{userInfo.avatarUrl || '/images/icons/avatar.png'}}" mode="aspectFill" />
    <view class="user-details">
      <text class="nickname">{{userInfo.nickName || '点击登录'}}</text>
      <text class="login-tip">{{userInfo ? '欢迎回来' : '登录以同步数据'}}</text>
    </view>
    <image wx:if="{{userInfo}}" class="arrow-icon" src="/images/icons/arrow-right.png" />
  </view>
  
  <!-- Menu -->
  <view class="menu-section">
    <view class="menu-item" bindtap="viewHistory">
      <image class="menu-icon" src="/images/icons/history.png" />
      <text class="menu-text">我的抽签</text>
      <image class="arrow-icon" src="/images/icons/arrow-right.png" />
    </view>
  </view>

  <view class="menu-section">
    <!-- <button class="menu-item" open-type="feedback">
      <image class="menu-icon" src="/images/icons/feedback.png" />
      <text class="menu-text">意见反馈</text>
      <image class="arrow-icon" src="/images/icons/arrow-right.png" />
    </button>
    <button class="menu-item" open-type="contact">
      <image class="menu-icon" src="/images/icons/contact.png" />
      <text class="menu-text">联系客服</text>
      <image class="arrow-icon" src="/images/icons/arrow-right.png" />
    </button> -->
    <view class="menu-item" bindtap="about">
      <image class="menu-icon" src="/images/icons/about.png" />
      <text class="menu-text">关于我们</text>
      <image class="arrow-icon" src="/images/icons/arrow-right.png" />
    </view>
    <view class="menu-item" bindtap="privacyPolicy">
      <image class="menu-icon" src="/images/icons/privacy.png" />
      <text class="menu-text">隐私协议</text>
      <image class="arrow-icon" src="/images/icons/arrow-right.png" />
    </view>
  </view>

  <!-- Footer -->
  <view class="footer">
    <text class="version">Version 1.2.0</text>
  </view>

  <!-- 昵称头像完善弹窗 -->
  <profile-sheet
    show="{{showProfileSheet}}"
    avatar-url="{{pendingAvatarUrl}}"
    bind:confirm="onProfileConfirm"
    bind:close="onProfileClose"
  />

  <!-- 关于我们 - Vant Action Sheet -->
  <van-action-sheet
    show="{{showAboutSheet}}"
    title="关于我们"
    bind:close="onAboutSheetClose"
  >
    <scroll-view scroll-y class="info-sheet-scroll">
      <view class="info-sheet-content">
        <view class="info-sheet-title">微信群抽签小程序</view>
        <view class="info-sheet-subtitle">版本 1.0.0</view>
        <view class="info-sheet-text">
          一个简单易用的微信群抽签工具，支持创建抽签、参与抽签和查看历史记录，帮助你在群里快速、公平地完成各种抽签活动。
        </view>
      </view>
    </scroll-view>
  </van-action-sheet>

  <!-- 隐私协议 - Vant Action Sheet -->
  <van-action-sheet
    show="{{showPrivacySheet}}"
    title="隐私协议"
    bind:close="onPrivacySheetClose"
  >
    <scroll-view scroll-y class="info-sheet-scroll">
      <view class="info-sheet-content info-sheet-text">
        <view class="info-sheet-section-title">我们重视您的隐私保护</view>
        <view class="info-sheet-section">1. 我们收集的信息：</view>
        <view>- 用户头像、昵称等基本资料</view>
        <view class="info-sheet-section">- 抽签相关的操作记录（如创建、参与、结果等）</view>

        <view class="info-sheet-section">2. 信息使用方式：</view>
        <view>- 用于在小程序内展示您的头像和昵称</view>
        <view>- 用于保证抽签功能的正常运行和历史记录查询</view>

        <view class="info-sheet-section">3. 信息保护：</view>
        <view>- 我们仅在本小程序业务范围内使用您的信息</view>
        <view>- 不会向未授权的第三方提供您的个人信息</view>

        <view class="info-sheet-section">感谢您的信任与支持！</view>
      </view>
    </scroll-view>
  </van-action-sheet>
</view>