.container {
  min-height: 100vh;
  background-color: #f7f8fa;
  padding: 24rpx;
  box-sizing: border-box;
  padding-bottom: calc(160rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.card {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

.form-item {
  display: flex;
  flex-direction: column;
}

.label-wrapper {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.label {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.tip {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 24rpx;
  margin-top: -12rpx;
}

.input, .option-input {
  height: 88rpx;
  border: 1rpx solid #f0f0f0;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  background-color: #f7f8fa;
  width: 100%;
  box-sizing: border-box;
  transition: all 0.2s ease;
}

.input:focus, .option-input:focus {
  background-color: #fff;
  border-color: #667eea;
}

.options-list {
  margin-bottom: 24rpx;
}

.option-item {
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  position: relative;
}

.option-input {
  padding-right: 80rpx;
}

.delete-btn {
  position: absolute;
  right: 16rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx;
}

.delete-icon {
  width: 32rpx;
  height: 32rpx;
}

.add-option-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border: 2rpx dashed #dcdfe6;
  border-radius: 16rpx;
  color: #606266;
  font-size: 28rpx;
  transition: all 0.2s ease;
}

.add-option-btn:active {
  background-color: #f7f8fa;
  border-color: #c0c4cc;
}

.add-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
  font-weight: bold;
}

.picker {
  height: 88rpx;
  border: 1rpx solid #f0f0f0;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  background-color: #f7f8fa;
  display: flex;
  align-items: center;
}

.picker .placeholder {
  color: #999;
}

.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 20rpx;
  padding: 24rpx 32rpx;
  background-color: #fff;
  border-top: 1rpx solid #f0f0f0;
  padding-bottom: calc(24rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.save-template-btn, .create-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
  margin: 0; /* 移除默认的 margin */
}

.save-template-btn {
  background-color: #fff;
  color: #667eea;
  border: 1rpx solid #667eea;
}

.create-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(118, 75, 162, 0.2);
}

.save-template-btn[disabled], .create-btn[disabled] {
  opacity: 0.5;
  box-shadow: none;
  background-image: none; /* 禁用状态下移除渐变 */
  background-color: #e0e0e0;
  color: #a0a0a0;
  border-color: transparent;
}
