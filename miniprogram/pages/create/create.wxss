.container {
  min-height: 100vh;
  background-color: #f7f8fa;
  padding: 24rpx;
  box-sizing: border-box;
  padding-bottom: calc(160rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.card {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

.form-item {
  display: flex;
  flex-direction: column;
}

.label-wrapper {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.label {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

/* info button next to label */
.info-btn {
  margin-left: 12rpx;
  font-size: 24rpx;
  color: #888;
}
.info-btn:active {
  opacity: 0.7;
}

.tip {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 24rpx;
}

.input, .option-input {
  height: 88rpx;
  border: 1rpx solid #f0f0f0;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  background-color: #f7f8fa;
  width: 100%;
  box-sizing: border-box;
  transition: all 0.2s ease;
}

.input:focus, .option-input:focus {
  background-color: #fff;
  border-color: #667eea;
}

.options-list {
  margin-bottom: 24rpx;
}

.option-item {
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  position: relative;
}

.option-input {
  padding-right: 80rpx;
}

.delete-btn {
  position: absolute;
  right: 16rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx;
}

.delete-icon {
  width: 32rpx;
  height: 32rpx;
}

.add-option-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border: 2rpx dashed #dcdfe6;
  border-radius: 16rpx;
  color: #606266;
  font-size: 28rpx;
  transition: all 0.2s ease;
}

.add-option-btn:active {
  background-color: #f7f8fa;
  border-color: #c0c4cc;
}

.add-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
  font-weight: bold;
}

.picker {
  height: 88rpx;
  border: 1rpx solid #f0f0f0;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  background-color: #f7f8fa;
  display: flex;
  align-items: center;
}

.picker .placeholder {
  color: #999;
}

.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 20rpx;
  padding: 24rpx 32rpx;
  background-color: #fff;
  border-top: 1rpx solid #f0f0f0;
  padding-bottom: calc(24rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.save-template-btn, .create-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 72rpx;
  border-radius: 36rpx;
  font-size: 26rpx;
  font-weight: bold;
  border: none;
  margin: 0; /* 移除默认的 margin */
}

.save-template-btn {
  background-color: #fff;
  color: #667eea;
  border: 1rpx solid #667eea;
}

.create-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(118, 75, 162, 0.2);
}

.save-template-btn.disabled, .create-btn.disabled {
  opacity: 0.5;
  box-shadow: none;
  background-image: none; /* 禁用状态下移除渐变 */
  background-color: #e0e0e0;
  color: #a0a0a0;
  border-color: transparent;
  pointer-events: none;
}

/* 抽签方式选择样式 */
.type-group {
  display: flex;
  flex-wrap: nowrap; /* 强制单行 */
  gap: 12rpx;
  padding: 6rpx 0 0 0;
  overflow-x: auto; /* 当屏幕太窄时允许横向滚动 */
}
.type-item {
  display: flex;
  align-items: center;
  padding: 8rpx 12rpx;
  border-radius: 24rpx;
  border: 1rpx solid #eef0f3;
  background-color: #fff;
  box-shadow: 0 1rpx 4rpx rgba(0,0,0,0.02);
  min-width: 140rpx;
}
.type-item:active { background-color: #fafbfd; }
.circle {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 1rpx solid #dfe6ea;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #fff;
}
.circle .check { color: #2ecc71; font-size: 20rpx; }
.check-icon {
  width: 32rpx;
  height: 32rpx;
}
.type-label {
  margin-left: 10rpx;
  font-size: 24rpx;
  color: #333;
}
.type-item.selected {
  border-color: #2ecc71;
  background-color: #f5fff5;
}
.type-item.selected .circle {
  background-color: #2ecc71;
  border-color: #2ecc71;
}
.type-item.selected .circle .check { color: #fff; font-weight: 700; }
.type-item.selected .type-label { color: #2ecc71; font-weight: 700; }

/* Bottom sheet content inside van-popup */
.sheet-content { padding: 16rpx 0 24rpx; }
.sheet-header { padding: 24rpx 32rpx 0; font-size: 32rpx; font-weight: 600; }
.sheet-body { padding: 12rpx 32rpx 24rpx; }
.sheet-item { margin-top: 24rpx; }
.sheet-title { font-size: 28rpx; font-weight: 500; color: #333; }
.sheet-desc { font-size: 26rpx; color: #666; margin-top: 8rpx; line-height: 1.6; }
.sheet-footer { padding: 20rpx 32rpx 40rpx; }
.sheet-close { width: 100%; background: var(--van-button-primary-background-color); color: #fff; text-align: center; border-radius: 12rpx; padding: 20rpx 0; font-size: 28rpx; }
