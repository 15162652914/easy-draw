<view class="container">
  <view class="card">
    <view class="form-item">
      <view class="label-wrapper">
        <text class="icon">📝</text>
        <text class="label">抽签标题</text>
      </view>
      <input 
        class="input" 
        placeholder="给你的抽签起个名字吧" 
        value="{{title}}" 
        bindinput="onTitleChange"
      />
    </view>
  </view>

  <view class="card">
    <view class="form-item">
      <view class="label-wrapper">
        <text class="icon">📄</text>
        <text class="label">模板描述（可选）</text>
      </view>
      <input
        class="input"
        placeholder="给模板写一句说明，方便下次识别"
        value="{{templateDesc}}"
        bindinput="onTemplateDescChange"
      />
    </view>
  </view>

  <view class="card">
    <view class="form-item">
      <view class="label-wrapper">
        <text class="icon">⚙️</text>
        <text class="label">抽签方式</text>
        <van-icon name="info-o" size="18px" color="#667eea" custom-style="margin-left: 10rpx;" bind:click="showTypeHelp" />
      </view>
      <view class="type-group">
        <view wx:for="{{typeOptions}}" wx:for-item="opt" wx:key="value" class="type-item {{type===opt.value? 'selected': ''}}" bindtap="onTypeSelect" data-value="{{opt.value}}">
          <view class="circle">
            <image wx:if="{{type===opt.value}}" src="/images/icons/check.png" class="check-icon" mode="aspectFit" />
          </view>
          <text class="type-label">{{opt.label}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="form-item">
      <view class="label-wrapper">
        <text class="icon">🗳️</text>
        <text class="label">抽签选项</text>
      </view>
      <text class="tip">点击选项可编辑，点击右侧按钮可删除</text>
      
      <view class="options-list">
        <view 
          wx:for="{{options}}" 
          wx:key="index" 
          class="option-item"
        >
          <input 
            class="option-input" 
            value="{{item}}" 
            placeholder="请输入选项内容"
            data-index="{{index}}"
            bindinput="onOptionChange"
          />
          <view class="delete-btn" bindtap="deleteOption" data-index="{{index}}">
            <image src="/images/icons/delete.png" class="delete-icon" />
          </view>
        </view>
      </view>
      
      <view class="add-option-btn" bindtap="addOption">
        <text class="add-icon">+</text>
        <text>添加一个选项</text>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="form-item">
      <view class="label-wrapper">
        <text class="icon">👥</text>
        <text class="label">最大参与人数</text>
      </view>
      <input
        class="input"
        type="number"
        placeholder="不限制（留空）"
        value="{{maxParticipants}}"
        bindinput="onMaxParticipantsChange"
      />
    </view>
  </view>

  <!-- 赢家名额，仅在随机抽选时显示 -->
  <view class="card" wx:if="{{type===2}}">
    <view class="form-item">
      <view class="label-wrapper">
        <text class="icon">🏆</text>
        <text class="label">赢家名额</text>
      </view>
      <text class="tip">当设置赢家名额时，将优先分配“获胜”选项，达到名额后分配其他选项。</text>
      <input
        class="input"
        type="number"
        placeholder="不设置（留空）"
        value="{{winnerQuota}}"
        bindinput="onWinnerQuotaChange"
      />
    </view>
  </view>

  <view class="card">
    <view class="form-item">
      <view class="label-wrapper">
        <text class="icon">⏰</text>
        <text class="label">过期时间</text>
      </view>
      <picker 
        class="picker" 
        mode="date" 
        value="{{expireDate}}" 
        start="{{today}}"
        bindchange="onExpireDateChange"
      >
        <view class="{{expireDate ? '' : 'placeholder'}}">{{expireDate || '不设置（永久有效）'}}</view>
      </picker>
    </view>
  </view>
  
  <view class="footer">
    <view
      class="save-template-btn {{(!title || options.length < 1) ? 'disabled' : ''}}"
      bindtap="saveTemplate"
    >
      保存为模板
    </view>
    <view 
      class="create-btn {{(!title || options.length < 2) ? 'disabled' : ''}}" 
      bindtap="createDraw"
    >
      创建抽签
    </view>
  </view>

  <!-- 抽签方式说明：Vant Weapp 底部弹出层 -->
  <van-popup show="{{showTypeSheet}}" position="bottom" round="true" close-on-click-overlay="true" bind:close="closeTypeSheet">
    <view class="sheet-content">
      <view class="sheet-header">抽签方式说明</view>
      <view class="sheet-body">
        <view class="sheet-item">
          <view class="sheet-title">顺序抽签（不重复）</view>
          <view class="sheet-desc">从签池随机分配，一人一个；签池用尽自动关闭。</view>
        </view>
        <view class="sheet-item">
          <view class="sheet-title">随机抽选（可重复）</view>
          <view class="sheet-desc">每次从选项随机选择；设置赢家名额时将优先分配“获胜”直至名额用尽。</view>
        </view>
        <!-- <view class="sheet-item">
          <view class="sheet-title">普通抽签</view>
          <view class="sheet-desc">当前与“顺序抽签”一致（后续可能扩展差异化行为）。</view>
        </view> -->
        <view class="sheet-item">
          <view class="sheet-title">分组抽签</view>
          <view class="sheet-desc">预留类型，后续版本将提供按组分配能力与规则设置。</view>
        </view>
      </view>
      <view class="sheet-footer" bindtap="closeTypeSheet">
        <view class="sheet-close">我知道了</view>
      </view>
    </view>
  </van-popup>

  <!-- 昵称编辑弹窗 -->
  <profile-sheet
    show="{{showProfileSheet}}"
    avatar-url="{{userInfo.avatarUrl || ''}}"
    nick-name="{{userInfo.nickName || ''}}"
    bind:confirm="onProfileSheetConfirm"
    bind:close="onProfileSheetClose"
  />
</view>